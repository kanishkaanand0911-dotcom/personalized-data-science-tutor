# Copy this file to .env and fill in real values. Never commit .env itself.
#
# EVERYTHING BELOW IS OPTIONAL. With no .env at all, the platform runs in
# deterministic mode: every lesson, quiz, challenge and chart still works and
# is still grounded in real numbers computed from your dataset -- only the
# wording is generated from templates rather than by a language model.

# Which provider to use: auto | gemini | anthropic | mock
#   auto   - use whichever key is set (default)
#   mock   - force deterministic mode even if a key is present
LLM_PROVIDER=auto

# GEMINI (recommended -- genuinely free tier, no credit card, no expiration)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.6-flash

# ANTHROPIC (alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Where learner progress, uploads and rendered charts are written.
# Defaults to data/state, data/uploads and data/charts under the project root.
# STATE_DIR=
# UPLOAD_DIR=
# CHART_DIR=
