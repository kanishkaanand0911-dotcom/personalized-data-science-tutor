# Copy this file to .env and fill in real values. Never commit .env itself.

# GEMINI (recommended -- genuinely free tier, no credit card, no expiration)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ANTHROPIC (alternative -- only a one-time trial credit, not permanently free)
# Only needed if you switch back to the Anthropic version of narration.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
